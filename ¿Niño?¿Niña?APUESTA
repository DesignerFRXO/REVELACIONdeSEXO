    <!-- LÓGICA JAVASCRIPT -->
    <script>
        // =========================================================================
        // 1. CONFIGURACIÓN DE ENLACES OFICIALES
        // =========================================================================
        const GOOGLE_FORM_URL = "https://forms.gle/CqB2DfFf8oY6hbN5A";
        // Convertimos el enlace pubhtml de tu pestaña "Resultado" a formato CSV directo
        const SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vTvPwm2th7Zr_PHDtjMX8XJvGUtLYap2cwYwX609HePsR4NVT-iSNkRSeHYNHsA4Ln8_Bjd4UxN9IQR/pub?gid=1331110909&single=true&output=csv";

        let simEditadoManualmente = false;

        // Asignar el enlace a los botones e iniciar sincronización
        document.addEventListener("DOMContentLoaded", () => {
            const btnHero = document.getElementById("btn-apostar-hero");
            const btnFooter = document.getElementById("btn-apostar-footer");
            
            btnHero.href = GOOGLE_FORM_URL;
            btnFooter.href = GOOGLE_FORM_URL;

            calcularSimulador();
            actualizarPozoEnVivo();
            // Refresca el pozo automáticamente cada 45 segundos
            setInterval(actualizarPozoEnVivo, 45000);
        });

        // =========================================================================
        // 2. LECTURA AUTOMÁTICA DESDE GOOGLE SHEETS (PESTAÑA "RESULTADO")
        // =========================================================================
        function parseCSV(text) {
            return text.trim().split(/\r?\n/).map(line => {
                const cols = [];
                let cur = "", inQuotes = false;
                for (let i = 0; i < line.length; i++) {
                    const ch = line[i];
                    if (ch === '"') {
                        inQuotes = !inQuotes;
                    } else if (ch === "," && !inQuotes) {
                        cols.push(cur.trim());
                        cur = "";
                    } else {
                        cur += ch;
                    }
                }
                cols.push(cur.trim());
                return cols;
            });
        }

        function extraerNumero(val) {
            if (!val) return NaN;
            // Soporta tanto punto decimal como coma decimal si viene formateado
            let limpio = val.replace(/[^0-9.,-]+/g, "");
            if (limpio.includes(",") && !limpio.includes(".")) {
                limpio = limpio.replace(",", ".");
            } else if (limpio.includes(",") && limpio.includes(".")) {
                limpio = limpio.replace(/,/g, "");
            }
            return parseFloat(limpio);
        }

        async function actualizarPozoEnVivo() {
            const estadoEl = document.getElementById("estado-pozo");
            try {
                const res = await fetch(`${SHEET_CSV_URL}&t=${Date.now()}`);
                if (!res.ok) throw new Error("Error al leer Google Sheets");
                const csvText = await res.text();
                const rows = parseCSV(csvText);

                let pozoTotal = null;
                let pozoNino = null;
                let pozoNina = null;

                // Búsqueda inteligente por etiqueta (funciona sin importar en qué fila los pusiste)
                for (const row of rows) {
                    const etiqueta = (row[0] || "").toLowerCase();
                    const valor = extraerNumero(row[1]);
                    if (!isNaN(valor)) {
                        if (etiqueta.includes("total recaudado") || etiqueta.includes("pozo total")) {
                            pozoTotal = valor;
                        } else if (etiqueta.includes("niño") || etiqueta.includes("nino")) {
                            pozoNino = valor;
                        } else if (etiqueta.includes("niña") || etiqueta.includes("nina")) {
                            pozoNina = valor;
                        }
                    }
                }

                // Respaldo por posición estándar si las etiquetas tienen otro texto
                if (pozoTotal === null && rows[3]) pozoTotal = extraerNumero(rows[3][1]) || 0;
                if (pozoNino === null && rows[4]) pozoNino = extraerNumero(rows[4][1]) || 0;
                if (pozoNina === null && rows[5]) pozoNina = extraerNumero(rows[5][1]) || 0;

                pozoNino = pozoNino || 0;
                pozoNina = pozoNina || 0;
                pozoTotal = pozoTotal !== null ? pozoTotal : (pozoNino + pozoNina);

                // Actualizar marcador en vivo
                document.getElementById("live-total").textContent = `$${pozoTotal.toFixed(2)}`;
                document.getElementById("live-nino").textContent = `$${pozoNino.toFixed(2)}`;
                document.getElementById("live-nina").textContent = `$${pozoNina.toFixed(2)}`;

                // Sincronizar el simulador con los montos reales si el usuario no lo está editando
                if (!simEditadoManualmente) {
                    document.getElementById("sim-nino").value = pozoNino;
                    document.getElementById("sim-nina").value = pozoNina;
                    calcularSimulador();
                }

                const hora = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
                estadoEl.textContent = `Actualizado: ${hora}`;
            } catch (error) {
                console.error("Error sincronizando el pozo:", error);
                estadoEl.textContent = "En espera de datos en vivo";
            }
        }

        // =========================================================================
        // 3. SIMULADOR DE GANANCIAS EN TIEMPO REAL
        // =========================================================================
        const inputNino = document.getElementById("sim-nino");
        const inputNina = document.getElementById("sim-nina");
        const inputApuesta = document.getElementById("sim-tu-apuesta");

        function calcularSimulador() {
            const pozoNino = Math.max(0, parseFloat(inputNino.value) || 0);
            const pozoNina = Math.max(0, parseFloat(inputNina.value) || 0);
            const miApuesta = Math.max(1, parseFloat(inputApuesta.value) || 0);

            // Escenario si gana Niño (se suma tu apuesta al pozo de Niño)
            const totalSiNino = pozoNino + pozoNina + miApuesta;
            const pozoGanadoresNino = totalSiNino * 0.70;
            const pagoNino = Math.max(miApuesta, miApuesta * (pozoGanadoresNino / (pozoNino + miApuesta)));

            // Escenario si gana Niña (se suma tu apuesta al pozo de Niña)
            const totalSiNina = pozoNino + pozoNina + miApuesta;
            const pozoGanadoresNina = totalSiNina * 0.70;
            const pagoNina = Math.max(miApuesta, miApuesta * (pozoGanadoresNina / (pozoNina + miApuesta)));

            document.getElementById("res-nino").textContent = `$${pagoNino.toFixed(2)} USD`;
            document.getElementById("res-nina").textContent = `$${pagoNina.toFixed(2)} USD`;
        }

        [inputNino, inputNina].forEach(el => {
            el.addEventListener("input", () => {
                simEditadoManualmente = true;
                calcularSimulador();
            });
        });
        inputApuesta.addEventListener("input", calcularSimulador);

        // =========================================================================
        // 4. COPIAR ENLACE AL PORTAPAPELES
        // =========================================================================
        function copiarEnlace() {
            const tempInput = document.createElement("input");
            tempInput.value = window.location.href;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);
            mostrarToast("¡Enlace copiado! Pégalo en el grupo de WhatsApp 📲");
        }

        function mostrarToast(mensaje) {
            const toast = document.getElementById("toast");
            toast.textContent = mensaje;
            toast.classList.remove("translate-y-24", "opacity-0");
            setTimeout(() => {
                toast.classList.add("translate-y-24", "opacity-0");
            }, 3500);
        }
    </script>
</body>
</html>
